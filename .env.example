# King City Disposal - Environment Variables
# ============================================
# Add these in Vercel Dashboard → Settings → Environment Variables
# ============================================

# ===========================================
# SUPABASE (Database)
# ===========================================
# Get these from Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# TWILIO (SMS Notifications)
# ===========================================
# Get these from Twilio Console
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+16185551234
OWNER_PHONE=+16185551234

# ===========================================
# STRIPE (Payments)
# ===========================================
# Get these from Stripe Dashboard → Developers → API Keys
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...

# ===========================================
# MAPBOX (Optional - for satellite map tiles)
# ===========================================
# Sign up at https://mapbox.com (free tier: 50,000 loads/month)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
