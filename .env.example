# King City Disposal - Environment Variables
# ============================================
# Add these in Vercel Dashboard -> Settings -> Environment Variables
# ============================================

# ===========================================
# SUPABASE (Database) - REQUIRED
# ===========================================
# Get these from Supabase -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# TWILIO (SMS Notifications) - REQUIRED
# ===========================================
# Get these from Twilio Console
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+16185551234
OWNER_PHONE=+16185551234

# ===========================================
# STRIPE (Payments) - REQUIRED for online payments
# ===========================================
# Get these from Stripe Dashboard -> Developers -> API Keys
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ===========================================
# GOOGLE MAPS - REQUIRED for satellite maps
# ===========================================
# Get from Google Cloud Console -> APIs & Services -> Credentials
# Enable: Maps JavaScript API, Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key

# ===========================================
# ANTHROPIC AI - REQUIRED for document parsing
# ===========================================
# Get from Anthropic Console -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ===========================================
# ADMIN & SECURITY - REQUIRED
# ===========================================
# Admin dashboard password (change this!)
ADMIN_PASSWORD=your-secure-password-here

# Cron job secret (generate a random string)
CRON_SECRET=your-random-cron-secret

# ===========================================
# SITE URL - REQUIRED for SMS links
# ===========================================
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ===========================================
# RESEND (Email) - REQUIRED for email notifications
# ===========================================
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=King City Disposal <noreply@yourdomain.com>
RESEND_DOMAIN=yourdomain.com

# Optional: Owner email for email notifications
OWNER_EMAIL=owner@example.com

# ===========================================
# MAPBOX (Optional - alternative to Google Maps)
# ===========================================
# Sign up at https://mapbox.com (free tier: 50,000 loads/month)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
